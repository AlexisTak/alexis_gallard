---
import { getImage } from 'astro:assets';
import logo from '../assets/logo-ag-transparent.png';

interface Props {
	statement: string;
	support: string;
}

const { statement, support } = Astro.props;

const traits = ['Architecture', 'IA appliquée', 'Production', 'Autonomie'];

/* Même variante WebP que celle servie ailleurs : demandée ici à la main parce
   que le filigrane est posé en image de fond et non par une balise. */
const filigrane = await getImage({ src: logo, width: 413, format: 'webp', quality: 50 });
---

{/* Aucune révélation ici : ce bloc est le premier contenu peint, et souvent
    l'élément retenu pour le LCP. Le masquer jusqu'à ce qu'un script le
    dévoile ajoutait près de huit cents millisecondes sur mobile. */}
<section class="card relative overflow-hidden p-6 md:p-10 lg:p-14">
	{/* Filigrane décoratif, absent sur mobile.

	    Posé en image de fond et non par une balise : un `<img>` masqué par
	    `display: none` est téléchargé quand même, une image de fond ne l'est
	    pas. Sur téléphone, rien ne part donc sur le réseau.

	    Le tracé est rogné sans marge interne, d'où le positionnement positif :
	    la moindre valeur négative couperait le monogramme. Sa largeur est celle
	    du fichier source — l'agrandir doublerait le poids servi sans rien
	    apporter à l'écran. */}
	<div aria-hidden="true" class="filigrane pointer-events-none absolute right-2 top-4"></div>

	<div class="relative">
		<p class="pill bg-slate text-slate-ink">Poitiers · Nouvelle-Aquitaine</p>

		<h1
			class="display mt-8 max-w-[16ch] text-[clamp(2.4rem,7vw,5.2rem)] text-text"
		>
			{statement}
		</h1>

		<p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-muted">
			{support}
		</p>

		<ul class="mt-10 flex flex-wrap gap-2">
			{traits.map((trait) => (
				<li class="pill border border-line text-muted">{trait}</li>
			))}
		</ul>

		<div class="mt-10 flex flex-wrap items-center gap-3">
			<a
				href="/contact"
				class="pill bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
			>
				Échangeons
			</a>
			<a
				href="/projets"
				class="pill border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			>
				Voir le travail
			</a>
		</div>
	</div>
</section>

<style define:vars={{ filigraneUrl: `url(${filigrane.src})`, filigraneLargeur: `${filigrane.attributes.width ?? 413}px` }}>
	.filigrane {
		display: none;
	}

	@media (min-width: 48rem) {
		.filigrane {
			display: block;
			width: var(--filigraneLargeur);
			aspect-ratio: 413 / 329;
			background-image: var(--filigraneUrl);
			background-size: contain;
			background-repeat: no-repeat;
			opacity: 0.07;
		}
	}
</style>
