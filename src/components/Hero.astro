---
import Logo from './Logo.astro';

interface Props {
	statement: string;
	support: string;
}

const { statement, support } = Astro.props;

const traits = ['Architecture', 'IA appliquée', 'Production', 'Autonomie'];
---

<section class="card relative overflow-hidden p-6 md:p-10 lg:p-14">
	{/* Le monogramme tient la place que la référence donne au portrait : une
	    présence en grand, coupée par le cadre. */}
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -right-12 -top-16 opacity-[0.07] md:-right-16 md:-top-20"
	>
		<Logo size={360} />
	</div>

	<div class="relative">
		<p class="pill bg-slate text-slate-ink" data-reveal data-reveal-delay="0">Poitiers · Nouvelle-Aquitaine</p>

		<h1
			class="display mt-8 max-w-[16ch] text-[clamp(2.4rem,7vw,5.2rem)] text-text"
			data-reveal data-reveal-delay="90"
		>
			{statement}
		</h1>

		<p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-muted" data-reveal data-reveal-delay="180">
			{support}
		</p>

		<ul class="mt-10 flex flex-wrap gap-2" data-reveal data-reveal-delay="270">
			{traits.map((trait) => (
				<li class="pill border border-line text-muted">{trait}</li>
			))}
		</ul>

		<div class="mt-10 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="360">
			<a
				href="/contact"
				class="pill bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
			>
				Échangeons
			</a>
			<a
				href="/projets"
				class="pill border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			>
				Voir le travail
			</a>
		</div>
	</div>
</section>
