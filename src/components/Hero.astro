---
import Logo from './Logo.astro';

interface Props {
	statement: string;
	support: string;
}

const { statement, support } = Astro.props;

const traits = ['Architecture', 'IA appliquée', 'Production', 'Autonomie'];
---

{/* Aucune révélation ici : ce bloc est le premier contenu peint, et souvent
    l'élément retenu pour le LCP. Le masquer jusqu'à ce qu'un script le
    dévoile ajoutait près de huit cents millisecondes sur mobile. */}
<section class="card relative overflow-hidden p-6 md:p-10 lg:p-14">
	{/* Le monogramme tient la place que la référence donne au portrait. Le
	    image est rognée au tracé, sans marge interne : la moindre valeur
	    négative de position coupe donc le monogramme. La largeur est celle du
	    fichier source — tout rééchantillonnage doublerait le poids du fichier
	    servi sans rien apporter à l'écran. */}
	<div
		aria-hidden="true"
		class="pointer-events-none absolute right-0 top-5 opacity-[0.07] md:right-2 md:top-4"
	>
		<Logo size={413} plain />
	</div>

	<div class="relative">
		<p class="pill bg-slate text-slate-ink">Poitiers · Nouvelle-Aquitaine</p>

		<h1
			class="display mt-8 max-w-[16ch] text-[clamp(2.4rem,7vw,5.2rem)] text-text"
		>
			{statement}
		</h1>

		<p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-muted">
			{support}
		</p>

		<ul class="mt-10 flex flex-wrap gap-2">
			{traits.map((trait) => (
				<li class="pill border border-line text-muted">{trait}</li>
			))}
		</ul>

		<div class="mt-10 flex flex-wrap items-center gap-3">
			<a
				href="/contact"
				class="pill bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
			>
				Échangeons
			</a>
			<a
				href="/projets"
				class="pill border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			>
				Voir le travail
			</a>
		</div>
	</div>
</section>
