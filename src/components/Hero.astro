---
import Logo from './Logo.astro';

interface Props {
	statement: string;
	support: string;
}

const { statement, support } = Astro.props;

const traits = ['Architecture', 'IA appliquée', 'Production', 'Autonomie'];
---

<section class="card relative overflow-hidden p-6 md:p-10 lg:p-14">
	{/* Le monogramme tient la place que la référence donne au portrait : une
	    présence en grand, coupée par le cadre. */}
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -right-12 -top-16 opacity-[0.07] md:-right-16 md:-top-20"
	>
		<Logo size={360} />
	</div>

	<div class="relative">
		<p class="pill bg-slate text-slate-ink" data-hero-item>Poitiers · Nouvelle-Aquitaine</p>

		<h1
			class="display mt-8 max-w-[16ch] text-[clamp(2.4rem,7vw,5.2rem)] text-text"
			data-hero-item
		>
			{statement}
		</h1>

		<p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-muted" data-hero-item>
			{support}
		</p>

		<ul class="mt-10 flex flex-wrap gap-2" data-hero-item>
			{traits.map((trait) => (
				<li class="pill border border-line text-muted">{trait}</li>
			))}
		</ul>

		<div class="mt-10 flex flex-wrap items-center gap-3" data-hero-item>
			<a
				href="/contact"
				class="pill bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
			>
				Échangeons
			</a>
			<a
				href="/projets"
				class="pill border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			>
				Voir le travail
			</a>
		</div>
	</div>
</section>

<style is:global>
	.js-motion [data-hero-item] {
		opacity: 0;
	}
</style>

<script>
	import gsap from 'gsap';
	import { prefersReducedMotion } from '../scripts/motion';

	const items = gsap.utils.toArray<HTMLElement>('[data-hero-item]');

	if (prefersReducedMotion()) {
		gsap.set(items, { opacity: 1 });
	} else {
		// Filet : si l'horloge n'avance jamais, le hero doit rester lisible.
		const safety = window.setTimeout(() => gsap.set(items, { opacity: 1, y: 0 }), 2200);

		gsap.fromTo(
			items,
			{ opacity: 0, y: 18 },
			{
				opacity: 1,
				y: 0,
				duration: 0.7,
				ease: 'power3.out',
				stagger: 0.09,
				onComplete: () => window.clearTimeout(safety),
			},
		);
	}
</script>
