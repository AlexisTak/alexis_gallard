---
import { Image } from 'astro:assets';
import portrait from '../assets/photo.jpg';

interface Props {
	eyebrow: string;
	/** Phrase diffusée mot à mot, comme une réponse de modèle. */
	statement: string;
	support: string;
}

const { eyebrow, statement, support } = Astro.props;
---

<section class="relative isolate overflow-hidden">
	<canvas
		data-field
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-0"></canvas>

	<div class="mx-auto max-w-6xl px-6 pb-24 pt-20 md:pb-36 md:pt-32">
		<p class="label flex items-center gap-3" data-hero-item>
			<span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
			{eyebrow}
		</p>

		<div class="mt-10 flex flex-col-reverse gap-10 md:flex-row md:items-start md:gap-10">
			<h1 class="display flex-1 text-[clamp(2rem,6.6vw,5.5rem)] text-text" data-hero-headline>
				<span data-stream>{statement}</span><span aria-hidden="true" data-caret class="stream-caret"
				></span>
			</h1>

			<!-- L'animation d'entrée porte sur le conteneur : GSAP écrit une opacité
			     en ligne, qui écraserait le voile appliqué à l'image. -->
			<div data-hero-item class="shrink-0 self-start">
				<Image
					src={portrait}
					alt="Alexis Gallard"
					width={480}
					height={480}
					loading="eager"
					class="portrait-veil size-40 md:size-[clamp(11rem,17vw,15rem)]"
				/>
			</div>
		</div>

		<p class="mt-10 max-w-xl text-lg leading-relaxed text-text/70" data-hero-item>
			{support}
		</p>

		<div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4" data-hero-item>
			<a
				href="/contact"
				class="label border border-accent bg-accent px-5 py-3 !text-accent-ink transition-colors hover:bg-transparent hover:!text-accent"
			>
				Parler de votre projet
			</a>
			<a href="/projets" class="label border-b border-line-hi pb-1 transition-colors hover:!text-text">
				Voir le travail
			</a>
		</div>
	</div>
</section>

<style is:global>
	.js-motion [data-hero-item],
	.js-motion [data-hero-headline] {
		opacity: 0;
	}

	.stream-caret {
		display: inline-block;
		width: 0.5em;
		height: 0.78em;
		margin-left: 0.12em;
		background-color: var(--c-accent);
		vertical-align: baseline;
		animation: caret-blink 1.1s steps(1) infinite;
	}

	@keyframes caret-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stream-caret {
			display: none;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { SplitText } from 'gsap/SplitText';
	import { createHeroField } from '../scripts/hero-field';
	import { prefersReducedMotion } from '../scripts/motion';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-field]');
	const headline = document.querySelector<HTMLElement>('[data-hero-headline]');
	const stream = document.querySelector<HTMLElement>('[data-stream]');
	const caret = document.querySelector<HTMLElement>('[data-caret]');
	const items = gsap.utils.toArray<HTMLElement>('[data-hero-item]');

	if (prefersReducedMotion()) {
		gsap.set([headline, ...items].filter(Boolean), { opacity: 1 });
		gsap.set(caret, { display: 'none' });
	} else {
		gsap.registerPlugin(SplitText);

		// Le hero doit apparaître même si la séquence n'aboutit pas : les mots
		// découpés par SplitText n'existent pas encore, d'où le nettoyage large.
		const safety = window.setTimeout(() => {
			gsap.set([headline, ...items].filter(Boolean), { opacity: 1, y: 0 });
			if (headline) gsap.set(headline.querySelectorAll('*'), { clearProps: 'opacity,transform' });
			gsap.set(caret, { opacity: 0 });
		}, 2600);
		const cancelSafety = () => window.clearTimeout(safety);

		// Le champ ne démarre que sur un écran assez large : sur mobile il coûte
		// de la batterie pour un décor qu'on ne regarde pas.
		const field =
			canvas && window.matchMedia('(min-width: 768px)').matches
				? createHeroField(canvas)
				: null;

		if (field && canvas) {
			gsap.to(canvas, { opacity: 1, duration: 1.6, ease: 'power2.out' });
		}

		// On attend les polices : découper le texte avant qu'elles arrivent
		// donnerait des mots mal placés.
		const ready = document.fonts?.ready ?? Promise.resolve();

		ready.then(() => {
			const split = stream ? new SplitText(stream, { type: 'words' }) : null;

			const [eyebrow, ...rest] = items;
			const timeline = gsap.timeline({
				defaults: { ease: 'power3.out' },
				onComplete: cancelSafety,
			});

			timeline
				.fromTo(eyebrow, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.6 })
				.set(headline, { opacity: 1 })
				.from(
					split?.words ?? [],
					{ opacity: 0, yPercent: 45, duration: 0.5, stagger: 0.055 },
					'-=0.25',
				)
				.fromTo(rest, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.8, stagger: 0.12 }, '-=0.9')
				.to(
					caret,
					{
						opacity: 0,
						duration: 0.4,
						// Le clignotement est une animation CSS : il faut la couper
						// avant que GSAP ne prenne la main sur l'opacité.
						onStart: () => caret && (caret.style.animation = 'none'),
					},
					'-=0.4',
				)
				// L'onde part quand la phrase est complète : la recherche suit la requête.
				.add(() => field?.pulse());
		});
	}
</script>
