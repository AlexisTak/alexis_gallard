---
interface Props {
	eyebrow: string;
	title: string;
	lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="card p-6 md:p-10 lg:p-14">
	<p class="pill bg-slate text-slate-ink">{eyebrow}</p>
	<h1 class="display mt-8 max-w-[18ch] text-[clamp(2.2rem,6vw,4.4rem)] text-text">{title}</h1>
	{lede && <p class="mt-8 max-w-[56ch] text-lg leading-relaxed text-muted">{lede}</p>}
</header>
