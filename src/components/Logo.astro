---
import { Image } from 'astro:assets';
import logo from '../assets/logo-ag-transparent.png';

interface Props {
	/** Largeur d'affichage du monogramme en pixels. */
	size?: number;
	/**
	 * Sans la pastille sombre : réservé au filigrane, où le monogramme doit
	 * flotter seul sans poser de bloc de couleur.
	 */
	plain?: boolean;
	class?: string;
}

const { size = 28, plain = false, class: className } = Astro.props;

/* Le monogramme est plus large que haut. Dans la pastille, c'est donc la
   largeur qui contraint : on l'inscrit dans le carré en retirant la marge. */
const largeur = plain ? size : Math.round(size * 0.74);
---

{/* Astro produit une variante WebP à la définition demandée. Servir un PNG de
    96 pixels agrandi à 360 donnait un filigrane visiblement flou en thème
    sombre, où le contraste est bien plus fort qu'en thème clair. Le filigrane
    n'a pas de variante double : elle serait plafonnée à la définition du
    fichier source, donc identique au fichier simple.

    Chargement immédiat malgré le rôle décoratif : mesuré, ce filigrane est
    l'élément retenu pour le LCP de l'accueil, et un élément mesuré ne se
    diffère pas. À noter, pour ne pas s'en attribuer le mérite : sur réseau
    lent, le différer ou non ne change rien de mesurable — le délai vient du
    téléchargement du document et des polices, pas de l'attribut. */}
{
	plain ? (
		<Image
			src={logo}
			alt=""
			width={largeur}
			quality={50}
			loading="eager"
			class:list={['block h-auto max-w-full', className]}
		/>
	) : (
		/* Pastille encre plutôt que fond transparent : le doré manque de
		   contraste sur la carte crème, et `--c-accent-ink` est le seul jeton
		   identique en thème clair et sombre, donc la pastille ne s'inverse pas. */
		<span
			class:list={['inline-flex shrink-0 items-center justify-center rounded-[26%] bg-accent-ink', className]}
			style={`width:${size}px;height:${size}px`}
		>
			<Image src={logo} alt="" width={largeur} densities={[1, 2]} loading="eager" />
		</span>
	)
}
