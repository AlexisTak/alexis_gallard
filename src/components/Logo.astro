---
import { Image } from 'astro:assets';
import logo from '../assets/logo-ag-transparent.png';

interface Props {
	/** Côté de la pastille en pixels. */
	size?: number;
	class?: string;
}

const { size = 28, class: className } = Astro.props;

/* Le monogramme est plus large que haut : dans la pastille, c'est donc la
   largeur qui contraint. Dimension calculée plutôt qu'un pourcentage, qui
   s'effondrerait à zéro faute de référence dans un conteneur centré. */
const largeur = Math.round(size * 0.74);
---

{/* Pastille encre plutôt que fond transparent : le doré manque de contraste
    sur la carte crème, et `--c-accent-ink` est le seul jeton identique en
    thème clair et sombre, donc la pastille ne s'inverse pas. */}
<span
	class:list={['inline-flex shrink-0 items-center justify-center rounded-[26%] bg-accent-ink', className]}
	style={`width:${size}px;height:${size}px`}
>
	<Image src={logo} alt="" width={largeur} densities={[1, 2]} loading="eager" />
</span>
