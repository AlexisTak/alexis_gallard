---
interface Props {
	label: string;
	id?: string;
	/** Filet supérieur : coupé pour la première section suivant le hero. */
	rule?: boolean;
}

const { label, id, rule = true } = Astro.props;
---

<section id={id} class:list={['border-line', rule && 'border-t']}>
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-24 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-16 md:py-32">
		<p class="label self-start md:sticky md:top-28">{label}</p>
		<div>
			<slot />
		</div>
	</div>
</section>
