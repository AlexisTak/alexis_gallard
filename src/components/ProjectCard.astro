---
interface Props {
	slug: string;
	title: string;
	subtitle: string;
	summary: string;
	stack: string[];
}

const { slug, title, subtitle, summary, stack } = Astro.props;
---

<a
	href={`/projets/${slug}`}
	class="group flex flex-col gap-3 rounded-2xl border border-ink/10 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/5"
>
	<div>
		<h3 class="text-xl font-semibold text-ink group-hover:text-accent">{title}</h3>
		<p class="text-sm text-ink/60">{subtitle}</p>
	</div>
	<p class="text-sm leading-relaxed text-ink/80">{summary}</p>
	<ul class="mt-auto flex flex-wrap gap-2 pt-2">
		{stack.map((tech) => (
			<li class="rounded-full bg-ink/5 px-3 py-1 text-xs font-medium text-ink/70">{tech}</li>
		))}
	</ul>
	<span class="mt-2 text-sm font-medium text-accent">Voir l'étude de cas →</span>
</a>
