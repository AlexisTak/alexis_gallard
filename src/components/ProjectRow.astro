---
interface Props {
	slug: string;
	title: string;
	subtitle: string;
	summary: string;
	stack: string[];
	delay?: number;
}

const { slug, title, subtitle, summary, stack, delay = 0 } = Astro.props;
---

<a
	href={`/projets/${slug}`}
	data-reveal
	data-reveal-delay={delay}
	class="group block border-t border-line py-10 transition-colors duration-300 hover:border-accent"
>
	<div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-12">
		<div>
			<h3
				class="display text-[clamp(1.8rem,4.2vw,3rem)] text-text transition-colors duration-300 group-hover:text-accent"
			>
				{title}
			</h3>
			<p class="mt-3 text-sm text-muted">{subtitle}</p>
		</div>

		<div class="flex flex-col gap-6">
			<p class="max-w-[52ch] leading-relaxed text-text/80">{summary}</p>
			<ul class="flex flex-wrap gap-x-4 gap-y-2">
				{stack.map((tech) => <li class="label">{tech}</li>)}
			</ul>
			<span
				class="label transition-colors group-hover:!text-accent"
			>
				Étude de cas ↗
			</span>
		</div>
	</div>
</a>
