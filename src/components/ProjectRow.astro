---
interface Props {
	slug: string;
	title: string;
	subtitle: string;
	summary: string;
	stack: string[];
	delay?: number;
}

const { slug, title, subtitle, summary, stack, delay = 0 } = Astro.props;
---

<a
	href={`/projets/${slug}`}
	data-reveal
	data-reveal-delay={delay}
	class="group flex flex-col gap-5 rounded-[var(--radius-card)] border border-line bg-surface-hi p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-strong md:p-8"
>
	<div class="flex items-start justify-between gap-4">
		<div>
			<h3 class="display text-2xl text-text transition-colors group-hover:text-accent-strong md:text-3xl">
				{title}
			</h3>
			<p class="mt-2 text-sm text-muted">{subtitle}</p>
		</div>
		<span
			aria-hidden="true"
			class="pill shrink-0 border border-line text-muted transition-colors group-hover:border-accent-strong group-hover:text-accent-strong"
		>
			↗
		</span>
	</div>

	<p class="max-w-[56ch] leading-relaxed text-text/80">{summary}</p>

	<ul class="mt-auto flex flex-wrap gap-2">
		{stack.map((tech) => (
			<li class="pill bg-bg text-muted">{tech}</li>
		))}
	</ul>
</a>
