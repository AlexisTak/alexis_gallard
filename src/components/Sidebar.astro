---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';

const navItems = [
	{ href: '/', label: 'Accueil' },
	{ href: '/projets', label: 'Travail' },
	{ href: '/expertises', label: 'Expertises' },
	{ href: '/a-propos', label: 'Parcours' },
	{ href: '/blog', label: 'Écrits' },
	{ href: '/contact', label: 'Contact' },
];

const figures = [
	{ value: '12', unit: 'ans', note: "d'expérience" },
	{ value: '3', unit: 'domaines', note: 'web, IA, infra' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

{/* Carte de visite permanente : à partir de lg elle reste à l'écran pendant
    que le contenu défile ; en dessous elle redevient un en-tête classique. */}
<aside
	class="flex flex-col gap-3 p-4 lg:fixed lg:inset-y-0 lg:left-0 lg:z-40 lg:w-[19rem] lg:gap-4 lg:overflow-y-auto"
>
	<div class="card flex flex-col gap-4 p-4 lg:gap-5 lg:p-5">
		<div class="flex items-start justify-between gap-4">
			<a href="/" aria-label={`${SITE.name} — accueil`} class="group flex items-center gap-2.5">
				<Logo size={30} />
				<span class="whitespace-nowrap text-[0.95rem] font-semibold tracking-tight transition-colors group-hover:text-accent-strong">
					{SITE.name}
				</span>
			</a>

			{/* Icone plutot que libelle : le mot « Sombre » retirait au nom la
			    largeur qui lui manquait pour tenir sur une ligne. */}
			<button
				id="theme-toggle"
				type="button"
				aria-label="Basculer entre thème clair et sombre"
				class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-muted transition-colors hover:border-accent-strong hover:text-accent-strong"
			>
				<svg
					data-theme-icon="dark"
					width="15"
					height="15"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
				</svg>
				<svg
					data-theme-icon="light"
					width="15"
					height="15"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					class="hidden"
				>
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>
		</div>

		<p class="hidden text-sm leading-relaxed text-muted lg:block">
			Développeur Fullstack Senior et AI&nbsp;Engineer. Applications web, logiciels desktop en Rust,
			IA appliquée — de l'architecture jusqu'à la production.
		</p>

		<p class="pill w-fit bg-accent text-accent-ink">
			<span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-ink"></span>
			Ouvert aux opportunités
		</p>
	</div>

	<div class="hidden grid-cols-2 gap-4 lg:grid">
		{figures.map((figure) => (
			<div class="card flex flex-col justify-between p-5">
				<p class="display text-4xl text-accent-strong">{figure.value}</p>
				<p class="mt-2 text-sm font-medium text-text">{figure.unit}</p>
				<p class="text-xs text-muted">{figure.note}</p>
			</div>
		))}
	</div>

	<nav aria-label="Navigation principale" class="card p-3">
		<ul class="flex flex-wrap gap-1.5 lg:flex-col">
			{navItems.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={isCurrent(item.href) ? 'page' : undefined}
						class:list={[
							'pill w-full transition-colors',
							isCurrent(item.href)
								? 'bg-slate text-slate-ink'
								: 'text-muted hover:bg-surface-hi hover:text-text',
						]}
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="card hidden flex-col gap-3 p-5 lg:mt-auto lg:flex">
		<button
			type="button"
			data-copy={SITE.email}
			class="flex w-full items-center justify-between gap-3 rounded-lg border border-line px-3 py-2.5 text-left text-xs text-muted transition-colors hover:border-accent-strong hover:text-text"
		>
			<span class="truncate">{SITE.email}</span>
			<span class="label shrink-0" data-copy-label>Copier</span>
		</button>

		<a
			href="/contact"
			class="pill w-full justify-center bg-slate py-3 text-slate-ink transition-opacity hover:opacity-90"
		>
			Échangeons
		</a>
	</div>
</aside>

<script>
	// Bascule de thème : clair par défaut, choix mémorisé.
	const toggle = document.getElementById('theme-toggle');
	const moon = document.querySelector<SVGElement>('[data-theme-icon="dark"]');
	const sun = document.querySelector<SVGElement>('[data-theme-icon="light"]');

	// L'icône montre la destination : lune quand on peut passer au sombre.
	// Le masquage passe par une classe : l'attribut `hidden` ne masque pas un
	// SVG, la règle des feuilles par défaut ne visant que les éléments HTML.
	const syncLabel = () => {
		const isDark = document.documentElement.dataset.theme === 'dark';
		moon?.classList.toggle('hidden', isDark);
		sun?.classList.toggle('hidden', !isDark);
	};

	syncLabel();

	toggle?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		syncLabel();
	});

	// Copie de l'adresse : un recruteur qui note une adresse à la main se trompe.
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		const feedback = button.querySelector('[data-copy-label]');
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				if (feedback) {
					feedback.textContent = 'Copié';
					window.setTimeout(() => (feedback.textContent = 'Copier'), 1800);
				}
			} catch {
				// Presse-papiers refusé : l'adresse reste lisible et sélectionnable.
			}
		});
	});
</script>
