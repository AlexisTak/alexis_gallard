---
import { SITE, stackSentence } from '../lib/site';

const year = new Date().getFullYear();

const channels = [
	{ href: `mailto:${SITE.email}`, label: SITE.email },
	{ href: 'tel:0765723070', label: '07 65 72 30 70' },
	{ href: SITE.profiles[0], label: 'LinkedIn ↗', external: true },
	{ href: SITE.profiles[1], label: 'GitHub ↗', external: true },
];
---

<footer class="p-4 lg:pl-0">
	<div class="card p-6 md:p-10">
		<div class="flex flex-col gap-10 md:flex-row md:justify-between">
			<div>
				<p class="pill bg-accent text-accent-ink">Ouvert aux opportunités</p>
				<a
					href={`mailto:${SITE.email}`}
					class="display mt-6 block max-w-[14ch] text-[clamp(1.6rem,4vw,2.8rem)] text-text transition-colors hover:text-accent-strong"
				>
					Parlons de votre équipe.
				</a>
			</div>

			<ul class="flex flex-col gap-2 md:text-right">
				{channels.map((channel) => (
					<li>
						<a
							href={channel.href}
							target={channel.external ? '_blank' : undefined}
							rel={channel.external ? 'noopener' : undefined}
							class="text-muted transition-colors hover:text-accent-strong"
						>
							{channel.label}
						</a>
					</li>
				))}
				<li class="mt-2">
					<a href="/cv-alexis-gallard.pdf" download class="text-muted transition-colors hover:text-accent-strong">
						CV · PDF
					</a>
				</li>
			</ul>
		</div>

		<div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} {SITE.name} · Développeur Fullstack Senior &amp; AI Engineer</p>
			<nav aria-label="Informations légales" class="flex gap-4">
				<a href="/mentions-legales/" class="hover:text-accent-strong">Mentions légales</a>
				<a href="/confidentialite/" class="hover:text-accent-strong">Confidentialité</a>
			</nav>
			<p>
				{stackSentence}
			</p>
		</div>
	</div>
</footer>
