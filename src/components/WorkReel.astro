---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
	label?: string;
}

const { projects, label = 'Travail' } = Astro.props;
const total = String(projects.length).padStart(2, '0');
---

<section data-reel class="relative border-t border-line">
	<div data-reel-stage class="flex min-h-screen items-center">
		<div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-24 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-16">
			<div class="flex items-center gap-4 md:block">
				<p class="label">{label}</p>
				<p class="label mt-0 md:mt-4">
					<span data-reel-index>01</span><span class="text-muted/50"> / {total}</span>
				</p>
			</div>

			<div class="flex gap-8">
				<!-- Rail de progression : où l'on en est dans la séquence. -->
				<div
					aria-hidden="true"
					class="relative hidden w-px shrink-0 bg-line md:block"
					data-reel-rail
				>
					<span
						data-reel-fill
						class="absolute left-0 top-0 block w-px origin-top bg-accent"
						style="height: 100%; transform: scaleY(0);"></span>
				</div>

				<div data-reel-panels class="min-h-[24rem] w-full">
					{projects.map((project, i) => (
						<article data-reel-panel class="w-full" data-panel-index={i}>
							<h3 class="display text-[clamp(2rem,6vw,4.5rem)] text-text">
								{project.data.title}
							</h3>
							<p class="mt-4 text-lg text-muted">{project.data.subtitle}</p>
							<p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-text/80">
								{project.data.summary}
							</p>
							<ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2">
								{project.data.stack.map((tech) => (
									<li class="label">{tech}</li>
								))}
							</ul>
							<a
								href={`/projets/${project.id}`}
								class="label mt-10 inline-block border-b border-line-hi pb-1 transition-colors hover:!text-accent"
							>
								Étude de cas ↗
							</a>
						</article>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	/* Sans JS, les projets se lisent les uns après les autres. La superposition
	   n'existe que quand le défilement pilote la séquence. */
	.js-motion [data-reel-panels] {
		position: relative;
	}

	.js-motion [data-reel-panel] {
		position: absolute;
		inset: 0;
	}

	[data-reel-panel] + [data-reel-panel] {
		margin-top: 5rem;
	}

	.js-motion [data-reel-panel] + [data-reel-panel] {
		margin-top: 0;
	}

	.reel-static [data-reel-panel] {
		position: static;
	}

	.reel-static [data-reel-panel] + [data-reel-panel] {
		margin-top: 5rem;
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { prefersReducedMotion } from '../scripts/motion';

	const section = document.querySelector<HTMLElement>('[data-reel]');
	const stage = document.querySelector<HTMLElement>('[data-reel-stage]');
	const panels = gsap.utils.toArray<HTMLElement>('[data-reel-panel]');
	const counter = document.querySelector<HTMLElement>('[data-reel-index]');
	const fill = document.querySelector<HTMLElement>('[data-reel-fill]');

	if (section && stage && panels.length > 1 && !prefersReducedMotion()) {
		gsap.registerPlugin(ScrollTrigger);

		// autoAlpha plutôt qu'opacity : un panneau masqué sort aussi du parcours
		// de tabulation, sinon on tabule vers des liens invisibles.
		gsap.set(panels.slice(1), { autoAlpha: 0, yPercent: 6 });
		gsap.set(panels[0], { autoAlpha: 1, yPercent: 0 });

		const steps = panels.length - 1;

		const timeline = gsap.timeline({
			scrollTrigger: {
				trigger: section,
				start: 'top top',
				end: () => `+=${window.innerHeight * steps}`,
				pin: stage,
				scrub: 0.6,
				snap: { snapTo: 1 / steps, duration: 0.25, ease: 'power1.inOut' },
				invalidateOnRefresh: true,
				onUpdate: (self) => {
					const index = Math.round(self.progress * steps);
					if (counter) counter.textContent = String(index + 1).padStart(2, '0');
					if (fill) {
						gsap.set(fill, { scaleY: steps === 0 ? 1 : (index + 1) / panels.length });
					}
				},
			},
		});

		panels.forEach((panel, i) => {
			if (i === 0) return;
			timeline
				.to(panels[i - 1], { autoAlpha: 0, yPercent: -6, duration: 0.4 }, i - 1)
				.fromTo(
					panel,
					{ autoAlpha: 0, yPercent: 6 },
					{ autoAlpha: 1, yPercent: 0, duration: 0.4 },
					i - 1 + 0.2,
				);
		});

		if (fill) gsap.set(fill, { scaleY: 1 / panels.length });

		// Si l'horloge de GSAP n'a jamais avancé, aucune image n'a été calculée :
		// on retombe sur une pile lisible plutôt que de laisser deux projets
		// invisibles pour toujours. Un onglet en arrière-plan gèle aussi cette
		// horloge — dans ce cas on rediffère au lieu de dégrader pour rien.
		const checkClock = () => {
			if (gsap.ticker.time > 0) return;
			if (document.hidden) {
				window.setTimeout(checkClock, 3000);
				return;
			}
			timeline.scrollTrigger?.kill();
			gsap.set(panels, { clearProps: 'all' });
			document.querySelector('[data-reel-panels]')?.classList.add('reel-static');
		};

		window.setTimeout(checkClock, 3000);
	} else {
		gsap.set(panels, { autoAlpha: 1, yPercent: 0 });
	}
</script>
