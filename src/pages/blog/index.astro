---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
	title="Blog — Alexis Gallard"
	description="Articles techniques sur le développement Fullstack et l'IA appliquée (LLM, RAG, agents)."
>
	<section class="mx-auto max-w-3xl px-6 pb-20 pt-20">
		<p class="mb-4 text-sm font-semibold uppercase tracking-wide text-accent">Blog</p>
		<h1 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">Articles techniques</h1>

		{posts.length === 0 ? (
			<p class="mt-8 text-ink/60">
				Premiers articles bientôt : RAG en production, choix d'architecture Fullstack, IA open source.
			</p>
		) : (
			<ul class="mt-10 space-y-6">
				{posts.map((post) => (
					<li class="border-b border-ink/10 pb-6">
						<a href={`/blog/${post.id}`} class="text-lg font-semibold text-ink hover:text-accent">
							{post.data.title}
						</a>
						<p class="mt-1 text-sm text-ink/60">{post.data.description}</p>
						<time class="mt-1 block text-xs text-ink/40" datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('fr-FR')}
						</time>
					</li>
				))}
			</ul>
		)}
	</section>
</Layout>
