---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const schemas = [
	{
		'@type': 'Blog',
		'@id': `${SITE.url}/blog/#blog`,
		name: 'Écrits',
		description: "Notes techniques sur le développement Fullstack et l'IA appliquée.",
		author: { '@id': `${SITE.url}/#person` },
		blogPost: posts.map((post) => ({
			'@type': 'BlogPosting',
			headline: post.data.title,
			description: post.data.description,
			datePublished: post.data.pubDate.toISOString(),
			url: `${SITE.url}/blog/${post.id}/`,
		})),
	},
];
---

<Layout
	breadcrumbs={[{ name: 'Écrits', path: '/blog/' }]}
	schemas={schemas}
	title="Écrits — Alexis Gallard"
	description="Notes techniques sur le développement Fullstack et l'IA appliquée : RAG en production, architecture, modèles open source."
>
	<PageHeader
		eyebrow="Écrits"
		title="Notes techniques."
		lede="Ce que j'apprends en production, écrit pendant que c'est encore frais."
	/>

	<Section label={posts.length > 0 ? `${posts.length} notes` : 'Bientôt'}>
		{posts.length === 0 ? (
			<p class="max-w-[52ch] text-lg leading-relaxed text-muted" data-reveal>
				Premières notes en préparation : RAG en production et ses pièges, arbitrer entre modèle
				propriétaire et open source, choisir sa stack sans suivre la mode.
			</p>
		) : (
			<div class="flex flex-col">
				{posts.map((post, i) => (
					<a
						href={`/blog/${post.id}`}
						class="group grid gap-3 border-t border-line py-8 transition-colors hover:border-accent md:grid-cols-[10rem_minmax(0,1fr)] md:gap-12"
						data-reveal
						data-reveal-delay={i * 70}
					>
						<time class="label self-start" datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('fr-FR')}
						</time>
						<div>
							<h2 class="text-xl font-medium text-text transition-colors group-hover:text-accent">
								{post.data.title}
							</h2>
							<p class="mt-2 max-w-[58ch] leading-relaxed text-muted">{post.data.description}</p>
						</div>
					</a>
				))}
			</div>
		)}
	</Section>
</Layout>
