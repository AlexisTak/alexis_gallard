---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const url = `${SITE.url}/blog/${post.id}/`;

const schemas = [
	{
		'@type': 'BlogPosting',
		'@id': `${url}#post`,
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.pubDate.toISOString(),
		dateModified: post.data.pubDate.toISOString(),
		url,
		author: { '@id': `${SITE.url}/#person` },
		publisher: { '@id': `${SITE.url}/#person` },
		inLanguage: SITE.lang,
		keywords: post.data.tags.join(', '),
		isPartOf: { '@id': `${SITE.url}/blog/#blog` },
	},
];
---

<Layout
	breadcrumbs={[
		{ name: 'Écrits', path: '/blog/' },
		{ name: post.data.title, path: `/blog/${post.id}/` },
	]}
	schemas={schemas}
	ogType="article"
	title={`${post.data.title} — Alexis Gallard`}
	description={post.data.description}
>
	<article class="mx-auto max-w-3xl px-6 pb-24 pt-20 md:pt-28">
		<a href="/blog" class="label transition-colors hover:!text-accent">← Écrits</a>

		<h1 class="display mt-8 text-[clamp(2rem,5.5vw,3.6rem)] text-text">{post.data.title}</h1>
		<time class="label mt-6 block" datetime={post.data.pubDate.toISOString()}>
			{post.data.pubDate.toLocaleDateString('fr-FR')}
		</time>

		<div
			class="mt-14 flex flex-col gap-6 text-lg leading-relaxed text-text/85 [&_a]:text-accent [&_a]:underline [&_code]:font-mono [&_code]:text-base [&_code]:text-accent [&_h2]:display [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-line [&_pre]:bg-surface [&_pre]:p-5 [&_pre_code]:text-text"
		>
			<Content />
		</div>
	</article>
</Layout>
