---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			/*
			 * Deux suggestions par article, choisies sur les étiquettes communes
			 * puis complétées par les plus récentes. Sans ces liens, chaque note
			 * est une impasse : le lecteur repart, et un moteur ne voit qu'une
			 * page isolée au lieu d'un ensemble cohérent sur un sujet.
			 */
			related: posts
				.filter((other) => other.id !== post.id)
				.map((other) => ({
					post: other,
					score: other.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
				}))
				.sort(
					(a, b) =>
						b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf(),
				)
				.slice(0, 2)
				.map((entry) => entry.post),
		},
	}));
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const url = `${SITE.url}/blog/${post.id}/`;

/* Approximation suffisante : les moteurs s'en servent pour situer la
   profondeur d'un texte, pas pour le compter au mot près. */
const wordCount = post.body?.trim().split(/\s+/).length ?? 0;

const schemas = [
	{
		'@type': 'BlogPosting',
		'@id': `${url}#post`,
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.pubDate.toISOString(),
		dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
		url,
		author: { '@id': `${SITE.url}/#person` },
		publisher: { '@id': `${SITE.url}/#person` },
		inLanguage: SITE.lang,
		keywords: post.data.tags.join(', '),
		articleSection: post.data.tags[0],
		wordCount,
		isPartOf: { '@id': `${SITE.url}/blog/#blog` },
	},
];
---

<Layout
	breadcrumbs={[
		{ name: 'Écrits', path: '/blog/' },
		{ name: post.data.title, path: `/blog/${post.id}/` },
	]}
	schemas={schemas}
	ogType="article"
	title={`${post.data.title} — Alexis Gallard`}
	description={post.data.description}
>
	<article class="mx-auto max-w-3xl px-6 pb-24 pt-20 md:pt-28">
		<a href="/blog" class="pill bg-bg text-muted transition-colors hover:text-accent-strong">← Écrits</a>

		<h1 class="display mt-8 text-[clamp(2rem,5.5vw,3.6rem)] text-text">{post.data.title}</h1>
		<div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1">
			<time class="label" datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString('fr-FR')}
			</time>
			{post.data.updatedDate && (
				<time class="label text-accent-strong" datetime={post.data.updatedDate.toISOString()}>
					· Mis à jour le {post.data.updatedDate.toLocaleDateString('fr-FR')}
				</time>
			)}
			<span class="label">· {Math.max(1, Math.round(wordCount / 200))} min de lecture</span>
		</div>

		<div
			class="mt-14 flex flex-col gap-6 text-lg leading-relaxed text-text/85 [&_a]:text-accent [&_a]:underline [&_code]:font-mono [&_code]:text-base [&_code]:text-accent [&_h2]:display [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-line [&_pre]:bg-surface [&_pre]:p-5 [&_pre_code]:text-text"
		>
			<Content />
		</div>

		{/* Un lien, pas un widget. Les boutons officiels des réseaux chargent
		    plusieurs dizaines de kilo-octets de script et déposent des traceurs
		    tiers — ce que la politique de confidentialité de ce site exclut. */}
		<footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
			<p class="label">Cet article vous a servi ?</p>

			<a
				href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
				target="_blank"
				rel="noopener"
				class="pill inline-flex min-h-11 items-center gap-2 border border-line px-4 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
					/>
				</svg>
				Partager sur LinkedIn
			</a>
		</footer>

		{related.length > 0 && (
			<nav aria-label="Autres articles" class="mt-14">
				<p class="label">À lire ensuite</p>
				<ul class="mt-4 flex flex-col">
					{related.map((other) => (
						<li>
							<a
								href={`/blog/${other.id}/`}
								class="group grid gap-2 border-t border-line py-6 transition-colors hover:border-accent md:grid-cols-[7rem_minmax(0,1fr)] md:gap-8"
							>
								<time class="label self-start" datetime={other.data.pubDate.toISOString()}>
									{other.data.pubDate.toLocaleDateString('fr-FR')}
								</time>
								<div>
									<span class="block font-medium text-text transition-colors group-hover:text-accent">
										{other.data.title}
									</span>
									<span class="mt-1 block text-base leading-relaxed text-muted">
										{other.data.description}
									</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			</nav>
		)}
	</article>
</Layout>
