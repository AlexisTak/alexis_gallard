---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

// Remplacer FORM_ID par l'identifiant de formulaire Formspree (https://formspree.io).
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/FORM_ID';

const field =
	'w-full border border-line bg-transparent px-4 py-3 text-text transition-colors placeholder:text-muted/60 focus:border-accent focus:outline-none';
---

<Layout
	title="Contact — Alexis Gallard"
	description="Décrivez votre projet Fullstack ou IA. Réponse sous 48 heures."
>
	<PageHeader
		eyebrow="Contact"
		title="Décrivez le besoin."
		lede="Quelques lignes suffisent pour commencer. Réponse sous 48 heures, avec un premier avis honnête sur la faisabilité."
	/>

	<Section label="Formulaire">
		<form action={FORMSPREE_ENDPOINT} method="POST" class="flex max-w-xl flex-col gap-6">
			<div>
				<label for="name" class="label mb-3 block">Nom</label>
				<input type="text" id="name" name="name" required class={field} />
			</div>
			<div>
				<label for="email" class="label mb-3 block">Email</label>
				<input type="email" id="email" name="email" required class={field} />
			</div>
			<div>
				<label for="message" class="label mb-3 block">Projet</label>
				<textarea id="message" name="message" rows="7" required class={field}></textarea>
			</div>
			<button
				type="submit"
				class="label self-start border border-accent bg-accent px-5 py-3 !text-accent-ink transition-colors hover:bg-transparent hover:!text-accent"
			>
				Envoyer
			</button>
		</form>
	</Section>

	<Section label="Direct">
		<ul class="flex flex-col gap-4">
			<li>
				<a
					href="mailto:alexis_gallard@outlook.fr"
					class="text-xl text-text transition-colors hover:text-accent"
				>
					alexis_gallard@outlook.fr
				</a>
			</li>
			<li>
				<a href="tel:0765723070" class="text-xl text-text transition-colors hover:text-accent">
					07 65 72 30 70
				</a>
			</li>
			<li>
				<a
					href="https://www.linkedin.com/in/alexis-gallard"
					target="_blank"
					rel="noopener"
					class="text-xl text-text transition-colors hover:text-accent"
				>
					linkedin.com/in/alexis-gallard ↗
				</a>
			</li>
		</ul>
	</Section>
</Layout>
