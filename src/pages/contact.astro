---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { SITE } from '../lib/site';

const channels = [
	{
		label: 'Email',
		value: 'alexis_gallard@outlook.fr',
		href: 'mailto:alexis_gallard@outlook.fr',
	},
	{
		label: 'Téléphone',
		value: '07 65 72 30 70',
		href: 'tel:0765723070',
	},
	{
		label: 'LinkedIn',
		value: 'linkedin.com/in/alexis-gallard',
		href: 'https://www.linkedin.com/in/alexis-gallard',
		external: true,
	},
	{
		label: 'GitHub',
		value: 'github.com/AlexisTak',
		href: 'https://github.com/AlexisTak',
		external: true,
	},
];

const schemas = [
	{
		'@type': 'ContactPage',
		name: 'Contact',
		mainEntity: { '@id': `${SITE.url}/#person` },
	},
];
---

<Layout
	breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
	schemas={schemas}
	title="Contact — Alexis Gallard"
	description="Développeur Fullstack Senior et AI Engineer, ouvert aux opportunités. Email, téléphone, LinkedIn et GitHub."
>
	<PageHeader
		eyebrow="Contact"
		title="Parlons-en."
		lede="Un poste, une mission, ou simplement une question technique. Réponse sous 48 heures."
	/>

	<Section label="Écrire">
		<ul class="flex flex-col">
			{channels.map((channel, i) => (
				<li class="border-t border-line" data-reveal data-reveal-delay={i * 70}>
					<a
						href={channel.href}
						target={channel.external ? '_blank' : undefined}
						rel={channel.external ? 'noopener' : undefined}
						class="group grid gap-2 py-6 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-12"
					>
						<span class="label self-center">{channel.label}</span>
						<span class="text-xl text-text transition-colors group-hover:text-accent">
							{channel.value}{channel.external && ' ↗'}
						</span>
					</a>
				</li>
			))}
		</ul>
	</Section>

	<Section label="Document">
		<a
			href="/cv-alexis-gallard.pdf"
			download
			class="label inline-block border border-line px-5 py-3 transition-colors hover:border-accent hover:!text-accent"
			data-reveal
		>
			Télécharger le CV · PDF
		</a>
	</Section>
</Layout>
