---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { title, subtitle, stack, summary, context, challenges, solution, results, link } = project.data;

const sections = [
	{ label: 'Contexte', text: context },
	{ label: 'Défis techniques', text: challenges },
	{ label: 'Solution', text: solution },
	{ label: 'Résultats', text: results },
];
---

<Layout title={`${title} — Alexis Gallard`} description={summary}>
	<article class="mx-auto max-w-3xl px-6 pb-20 pt-20">
		<a href="/projets" class="text-sm font-medium text-accent hover:underline">← Tous les projets</a>

		<h1 class="mt-6 text-3xl font-bold tracking-tight text-ink md:text-4xl">{title}</h1>
		<p class="mt-2 text-lg text-ink/60">{subtitle}</p>

		<ul class="mt-6 flex flex-wrap gap-2">
			{stack.map((tech: string) => (
				<li class="rounded-full bg-ink/5 px-3 py-1 text-xs font-medium text-ink/70">{tech}</li>
			))}
		</ul>

		{link && (
			<a
				href={link}
				target="_blank"
				rel="noopener"
				class="mt-6 inline-block text-sm font-semibold text-accent hover:underline"
			>
				Voir le site en production →
			</a>
		)}

		<div class="mt-12 space-y-10">
			{sections.map((section) => (
				<div>
					<h2 class="text-sm font-semibold uppercase tracking-wide text-ink/50">{section.label}</h2>
					<p class="mt-3 leading-relaxed text-ink/80">{section.text}</p>
				</div>
			))}
		</div>

		<div class="mt-16 rounded-2xl bg-ink p-8 text-center text-paper">
			<h2 class="text-xl font-bold">Un projet similaire en tête ?</h2>
			<a
				href="/contact"
				class="mt-4 inline-block rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-dark hover:text-paper"
			>
				Discutons-en
			</a>
		</div>
	</article>
</Layout>
