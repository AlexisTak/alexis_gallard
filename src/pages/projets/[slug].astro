---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { title, subtitle, stack, summary, context, challenges, solution, results, link } =
	project.data;

const sections = [
	{ label: 'Contexte', text: context },
	{ label: 'Défis', text: challenges },
	{ label: 'Solution', text: solution },
	{ label: 'Résultats', text: results },
];

const url = `${SITE.url}/projets/${project.id}/`;

const schemas = [
	{
		'@type': 'CreativeWork',
		'@id': `${url}#work`,
		name: title,
		alternateName: subtitle,
		description: summary,
		url,
		creator: { '@id': `${SITE.url}/#person` },
		author: { '@id': `${SITE.url}/#person` },
		keywords: stack.join(', '),
		inLanguage: SITE.lang,
		...(link ? { sameAs: link } : {}),
		// Le corps de l'etude de cas, en clair : ce qu'un moteur generatif cite.
		abstract: [context, challenges, solution, results].join(' '),
	},
];
---

<Layout
	breadcrumbs={[
		{ name: 'Travail', path: '/projets/' },
		{ name: title, path: `/projets/${project.id}/` },
	]}
	schemas={schemas}
	ogType="article"
	title={`${title} — Alexis Gallard`}
	description={summary}
>
	<article>
		<header class="mx-auto max-w-6xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
			<a href="/projets" class="pill bg-bg text-muted transition-colors hover:text-accent-strong">← Travail</a>

			<h1 class="display mt-8 max-w-[16ch] text-[clamp(1.9rem,7vw,5rem)] text-text">{title}</h1>
			<p class="mt-6 max-w-[52ch] text-lg text-muted">{subtitle}</p>

			<ul class="mt-10 flex flex-wrap gap-x-5 gap-y-2">
				{stack.map((tech: string) => <li class="label">{tech}</li>)}
			</ul>

			{link && (
				<a
					href={link}
					target="_blank"
					rel="noopener"
					class="pill mt-8 inline-flex border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
				>
					Voir en production ↗
				</a>
			)}
		</header>

		{sections.map((section) => (
			<Section label={section.label}>
				<p class="max-w-[58ch] text-lg leading-relaxed text-text/85" data-reveal>
					{section.text}
				</p>
			</Section>
		))}

		<Section label="Suite">
			<h2 class="display max-w-[16ch] text-[clamp(1.9rem,5vw,3.4rem)]" data-reveal>
				Envie d'en parler ?
			</h2>
			<a
				href="/contact"
				class="pill mt-8 inline-flex bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
				data-reveal
				data-reveal-delay="80"
			>
				Échangeons
			</a>
		</Section>
	</article>
</Layout>
