---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const schemas = [
	{
		'@type': 'CollectionPage',
		'@id': `${SITE.url}/projets/#collection`,
		name: 'Études de cas',
		mainEntity: {
			'@type': 'ItemList',
			numberOfItems: projects.length,
			itemListElement: projects.map((project, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: `${SITE.url}/projets/${project.id}/`,
				name: project.data.title,
			})),
		},
	},
];
---

<Layout
	breadcrumbs={[{ name: 'Travail', path: '/projets/' }]}
	schemas={schemas}
	title="Travail — Alexis Gallard"
	description="Zero-Secret, Agentic OS, La Minute de Code : projets livrés et travaux en cours en sécurité, IA et développement web."
>
	<PageHeader
		eyebrow="Travail"
		title="Des besoins concrets. Des choix expliqués."
		lede="Découvrez le problème de départ, mon rôle et les choix qui font avancer chaque projet. Le statut distingue les réalisations livrées des travaux en cours."
	/>

	<Section label={`${projects.length} projets`}>
		<div class="grid gap-4 md:grid-cols-2">
			{projects.map((project, i) => (
				<ProjectRow
					slug={project.id}
					title={project.data.title}
					subtitle={project.data.subtitle}
					summary={project.data.summary}
					stack={project.data.stack}
					status={project.data.status}
					role={project.data.role}
					delay={i * 90}
				/>
			))}
		</div>
	</Section>
</Layout>
