---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { SITE } from '../lib/site';

interface Job {
	role: string;
	place: string;
	start: string;
	/** Absent tant que le poste est en cours. */
	end?: string;
	note?: string;
	points: string[];
}

/**
 * Périodes en AAAA-MM, comme sur le CV. `note` explique un chevauchement quand
 * il y en a un : deux postes tenus ensemble, ou une transition entre les deux.
 */
const experience: Job[] = [
	{
		role: 'Développeur Fullstack Senior · AI Engineer',
		place: 'Indépendant',
		start: '2022-04',
		points: [
			"Architecture logicielle, analyse des besoins clients, conception d'API REST et développement Fullstack, avec tests unitaires et d'intégration.",
			"Déploiement de solutions d'IA open source en entreprise, réduisant la dépendance et les coûts liés aux LLM propriétaires.",
			"Agents IA et workflows automatisés ; hébergement et optimisation de modèles locaux selon les contraintes matérielles.",
			"Audit et migration d'infrastructures IA ; revues de code et d'architecture.",
		],
	},
	{
		role: 'Développeur Fullstack',
		place: 'Emmaüs Ruffec',
		start: '2014-10',
		end: '2023-01',
		note: "Derniers mois en parallèle du lancement de l'activité indépendante",
		points: [
			'Frontend JavaScript/TypeScript (React, Next.js, TailwindCSS) : responsive, SEO technique, accessibilité.',
			'Backend Node.js (Express, NestJS) et PHP : API REST/GraphQL, authentification JWT/OAuth.',
			'Conception et optimisation de bases PostgreSQL, MySQL, MongoDB, Redis.',
			'Cloud et DevOps : Docker, CI/CD, Linux, Nginx, Vercel, Supabase ; déploiement et maintenance en production.',
		],
	},
	{
		role: 'Assistant technique',
		place: 'Auto École Solidaire',
		start: '2016-02',
		end: '2022-09',
		note: 'Poste tenu en parallèle du poste chez Emmaüs Ruffec',
		points: [
			"Conception et maintenance de l'intranet de l'association.",
			'Support et formation des équipes aux outils informatiques ; gestion des dossiers bénéficiaires.',
		],
	},
];

const formatPeriod = (start: string, end?: string) => {
	const short = (value: string) => value.split('-').reverse().join('/');
	return `${short(start)} → ${end ? short(end) : "aujourd'hui"}`;
};

/** Nombre de mois entre deux repères AAAA-MM ; la date du jour fait office de fin. */
const monthsBetween = (start: string, end?: string) => {
	const [startYear, startMonth] = start.split('-').map(Number);
	const now = new Date();
	const [endYear, endMonth] = end
		? end.split('-').map(Number)
		: [now.getFullYear(), now.getMonth() + 1];
	return (endYear - startYear) * 12 + (endMonth - startMonth);
};

/** « 8 ans 3 mois ». La durée est ce qu'un recruteur cherche et que deux dates
    brutes l'obligent à calculer de tête. */
const formatDuration = (start: string, end?: string) => {
	const total = Math.max(monthsBetween(start, end), 1);
	const years = Math.floor(total / 12);
	const months = total % 12;
	const parts = [];
	if (years > 0) parts.push(`${years} an${years > 1 ? 's' : ''}`);
	if (months > 0) parts.push(`${months} mois`);
	return parts.join(' ');
};

/* Trié par date de fin décroissante, le poste en cours d'abord : c'est l'ordre
   qu'on attend d'une frise, et il reste juste si un poste est ajouté. */
const jobs = [...experience]
	.sort((a, b) => (b.end ?? '9999').localeCompare(a.end ?? '9999') || b.start.localeCompare(a.start))
	.map((job) => ({
		...job,
		period: formatPeriod(job.start, job.end),
		duration: formatDuration(job.start, job.end),
		current: !job.end,
	}));

const skillGroups = [
	{
		label: 'Développement',
		items: ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Vue.js', 'TailwindCSS', 'Node.js', 'NestJS', 'Laravel', 'PHP', 'REST API', 'GraphQL', 'Rust', 'Tauri', 'Applications desktop', 'Go'],
	},
	{
		label: 'Intelligence artificielle',
		items: ['LLM', 'Mistral', 'Qwen', 'Ollama', 'RAG', 'LoRA / fine-tuning', 'Agents IA', 'Orchestration multi-modèles', 'Déploiement local'],
	},
	{
		label: 'DevOps / Infrastructure',
		items: ['Docker', 'Kubernetes', 'Helm', 'ArgoCD', 'Traefik', 'Nginx', 'CI/CD', 'GitHub Actions', 'Azure', 'AWS', 'Cloudflare', 'Linux', 'Terraform', 'Prometheus', 'Grafana'],
	},
	{
		label: 'Bases de données',
		items: ['PostgreSQL', 'MySQL / MariaDB', 'MongoDB', 'Redis'],
	},
];

const schemas = [
	{
		'@type': 'ProfilePage',
		'@id': `${SITE.url}/a-propos/#profilepage`,
		mainEntity: { '@id': `${SITE.url}/#person` },
		about: {
			'@id': `${SITE.url}/#person`,
			hasOccupation: jobs.map((job) => ({
				'@type': 'Occupation',
				name: job.role,
				occupationLocation: { '@type': 'Place', name: job.place },
			})),
		},
	},
];
---

<Layout
	breadcrumbs={[{ name: 'Parcours', path: '/a-propos/' }]}
	schemas={schemas}
	title="Parcours — Alexis Gallard"
	description="12 ans en développement Fullstack et IA appliquée : parcours, compétences et façon de travailler."
>
	<PageHeader
		eyebrow="Parcours"
		title="12 ans à construire, déployer, optimiser."
		lede="Développeur Fullstack Senior et AI Engineer. Je conçois des applications web/mobile, des logiciels desktop en Rust et des outils métiers intégrant les technologies d'IA — LLM, RAG, fine-tuning, agents — avec un fort volet infrastructure et DevOps. J'interviens de la conception jusqu'à l'exploitation."
	/>

	<Section label="Expérience">
		{/* Frise plutôt que liste : le fil rend les chevauchements lisibles d'un
		    coup d'œil, là où deux dates côte à côte obligent à les reconstituer.
		    Le fil et les repères sont décoratifs, la structure reste une liste
		    ordonnée pour qui navigue au lecteur d'écran. */}
		<ol class="flex flex-col">
			{jobs.map((job, i) => (
				<li
					class="relative grid gap-3 pb-12 pl-7 last:pb-0 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10 md:pl-9"
					data-reveal
					data-reveal-delay={i * 80}
				>
					{i < jobs.length - 1 && (
						<span aria-hidden="true" class="absolute left-1.25 top-5 h-full w-px bg-line" />
					)}

					<span
						aria-hidden="true"
						class:list={[
							'absolute left-0 top-1.75 size-2.75 rounded-full border-2',
							job.current ? 'border-accent-strong bg-accent' : 'border-line-hi bg-bg',
						]}
					/>

					<div class="md:text-right">
						<p class="label whitespace-nowrap text-text">{job.period}</p>
						<p class="mt-1 text-xs text-muted">{job.duration}</p>
						{job.current && (
							<p class="pill mt-3 bg-accent text-accent-ink">En cours</p>
						)}
					</div>

					<div>
						<h2 class="text-xl font-medium text-text">{job.role}</h2>
						<p class="mt-1 text-sm text-muted">{job.place}</p>
						{job.note && <p class="label mt-3 text-accent-strong">{job.note}</p>}
						<ul class="mt-6 flex flex-col gap-3">
							{job.points.map((point) => (
								<li class="max-w-[58ch] leading-relaxed text-text/85">{point}</li>
							))}
						</ul>
					</div>
				</li>
			))}
		</ol>
	</Section>

	<Section label="Compétences">
		<div class="flex flex-col">
			{skillGroups.map((group, i) => (
				<div
					class="grid gap-4 border-t border-line py-8 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-12"
					data-reveal
					data-reveal-delay={i * 60}
				>
					<h2 class="label self-start">{group.label}</h2>
					<ul class="flex flex-wrap gap-x-5 gap-y-2">
						{group.items.map((item) => (
							<li class="text-text/85">{item}</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</Section>

	<Section label="Document">
		<a
			href="/cv-alexis-gallard.pdf"
			download
			class="pill inline-flex border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			data-reveal
		>
			Télécharger le CV · PDF
		</a>
	</Section>
</Layout>
