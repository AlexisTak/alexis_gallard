---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { SITE } from '../lib/site';

const domains = [
	{
		title: 'Application web ou desktop',
		description:
			"Applications et outils métiers de bout en bout, du cadrage à la production. Le découpage se décide au cas par cas : un monolithe modulaire tient très bien tant qu'une seule équipe le fait vivre, des microservices se justifient quand les parties évoluent ou montent en charge séparément. En logiciel installé : Rust, avec Tauri quand l'interface web est un atout, ou une interface native quand il faut de la performance et aucune dépendance au navigateur.",
		stack: [
			'TypeScript',
			'React · Next.js · Vue.js',
			'Node.js · NestJS',
			'Laravel · PHP',
			'Rust · Tauri',
			'Go · gin · Fiber',
			'Python · Django · FastAPI',
			'Microservices',
			'Monolithe modulaire',
			'Architecture hexagonale',
			'PostgreSQL · MySQL · MongoDB · Redis',
			"Tests unitaires et d'intégration",
		],
	},
	{
		title: 'IA appliquée et automatisation',
		description:
			"LLM intégrés à des outils réels : pipelines RAG sur des corpus internes, agents outillés qui prennent en charge des tâches répétitives, fine-tuning LoRA quand le prompt ne suffit plus. Automatisation des chaînes métier autour de ces modèles, et arbitrage entre modèles propriétaires et open source selon les contraintes de coût et de confidentialité — jusqu'à l'inférence auto-hébergée quand les données ne doivent pas sortir.",
		stack: [
			'Pipelines RAG',
			'Embeddings et recherche vectorielle',
			'Fine-tuning LoRA',
			'Agents et function calling',
			'Workflows automatisés',
			'Orchestration multi-modèles',
			'Quantification et inférence locale',
			'Évaluation des sorties',
		],
	},
	{
		title: 'Infrastructure et production',
		description:
			"Le versant qui décide si le reste tient : conteneurisation, orchestration, CI/CD, infrastructure décrite en code. Puis le déploiement lui-même, la supervision et les alertes — pour savoir qu'une chose casse avant que l'utilisateur ne le signale.",
		stack: [
			'Docker',
			'Kubernetes / Helm',
			'ArgoCD',
			'GitHub Actions',
			'Nginx / Traefik',
			'Terraform',
			'Linux et self-hosting',
			'AWS · Azure · Cloudflare',
			'Prometheus / Grafana',
			'Observabilité et alerting',
		],
	},
];

const schemas = [
	{
		'@type': 'ItemList',
		name: "Domaines d'intervention",
		itemListElement: domains.map((domain, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'Service',
				name: domain.title,
				description: domain.description,
				provider: { '@id': `${SITE.url}/#person` },
			},
		})),
	},
];
---

<Layout
	breadcrumbs={[{ name: 'Expertises', path: '/expertises/' }]}
	schemas={schemas}
	title="Expertises — Alexis Gallard"
	description="Applications web et desktop (Rust, Tauri), IA appliquée et automatisation (RAG, agents, fine-tuning), infrastructure et production. Domaines d'intervention et technologies."
>
	<PageHeader
		eyebrow="Expertises"
		title="Trois domaines, une même chaîne."
		lede="De l'architecture à l'exploitation. Ces trois domaines se recoupent en permanence : une intégration IA qui ne se déploie pas ne sert à rien, et une application qu'on ne sait pas superviser non plus."
	/>

	{domains.map((domain, i) => (
		<Section label={String(i + 1).padStart(2, '0')}>
			<div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-16" data-reveal>
				<div>
					<h2 class="display text-[clamp(1.9rem,5vw,3.2rem)] text-text">{domain.title}</h2>
					<p class="mt-6 max-w-[52ch] leading-relaxed text-text/70">{domain.description}</p>
				</div>
				<div class="self-start border-l border-line pl-6">
					<h3 class="label">Technologies</h3>
					<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 md:flex-col md:gap-2">
						{domain.stack.map((tech) => (
							<li class="text-sm text-text/80">{tech}</li>
						))}
					</ul>
				</div>
			</div>
		</Section>
	))}

	<Section label="Suite">
		<h2 class="display max-w-[18ch] text-[clamp(1.9rem,5vw,3.4rem)]" data-reveal>
			Un poste où ça compte ?
		</h2>
		<p class="mt-8 max-w-[52ch] leading-relaxed text-text/70" data-reveal data-reveal-delay="80">
			Je suis ouvert aux opportunités, en Nouvelle-Aquitaine ou à distance. Dites-moi ce que
			l'équipe construit.
		</p>
		<a
			href="/contact"
			class="label mt-12 inline-block border border-accent bg-accent px-5 py-3 text-accent-ink! transition-colors hover:bg-transparent hover:text-accent!"
			data-reveal
			data-reveal-delay="160"
		>
			Échangeons
		</a>
	</Section>
</Layout>
