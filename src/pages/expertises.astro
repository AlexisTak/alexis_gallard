---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { SITE } from '../lib/site';

const domains = [
	{
		title: 'Application web ou desktop',
		description:
			"Applications et outils métiers de bout en bout, du cadrage à la production. Le découpage se décide au cas par cas : un monolithe modulaire tient très bien tant qu'une seule équipe le fait vivre, des microservices se justifient quand les parties évoluent ou montent en charge séparément. En logiciel installé : Rust, avec Tauri quand l'interface web est un atout, ou une interface native quand il faut de la performance et aucune dépendance au navigateur.",
		stack: [
			'TypeScript',
			'React · Next.js · Vue.js',
			'Node.js · NestJS',
			'Laravel · PHP',
			'Rust · Tauri',
			'Go · gin · Fiber',
			'Python · Django · FastAPI',
			'Microservices',
			'Monolithe modulaire',
			'Architecture hexagonale',
			'PostgreSQL · MySQL · MongoDB · Redis',
			"Tests unitaires et d'intégration",
		],
	},
	{
		title: 'IA appliquée et automatisation',
		description:
			"LLM intégrés à des outils réels : pipelines RAG sur des corpus internes, agents outillés qui prennent en charge des tâches répétitives, fine-tuning LoRA quand le prompt ne suffit plus. Automatisation des chaînes métier autour de ces modèles, et arbitrage entre modèles propriétaires et open source selon les contraintes de coût et de confidentialité — jusqu'à l'inférence auto-hébergée quand les données ne doivent pas sortir.",
		stack: [
			'Pipelines RAG',
			'Embeddings et recherche vectorielle',
			'Fine-tuning LoRA',
			'Agents et function calling',
			'Workflows automatisés',
			'Orchestration multi-modèles',
			'Quantification et inférence locale',
			'Évaluation des sorties',
		],
	},
	{
		title: 'Infrastructure et production',
		description:
			"Le versant qui décide si le reste tient : conteneurisation, orchestration, CI/CD, infrastructure décrite en code. Puis le déploiement lui-même, la supervision et les alertes — pour savoir qu'une chose casse avant que l'utilisateur ne le signale.",
		stack: [
			'Docker',
			'Kubernetes / Helm',
			'ArgoCD',
			'GitHub Actions',
			'Nginx / Traefik',
			'Terraform',
			'Linux et self-hosting',
			'AWS · Azure · Cloudflare',
			'Prometheus / Grafana',
			'Observabilité et alerting',
		],
	},
];

const schemas = [
	{
		'@type': 'ItemList',
		name: "Domaines d'intervention",
		itemListElement: domains.map((domain, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'Service',
				'@id': `${SITE.url}/expertises/#service-${index + 1}`,
				url: `${SITE.url}/expertises/#service-${index + 1}`,
				areaServed: { '@type': 'Country', name: 'France' },
				name: domain.title,
				description: domain.description,
				provider: { '@id': `${SITE.url}/#person` },
			},
		})),
	},
];
---

<Layout
	breadcrumbs={[{ name: 'Expertises', path: '/expertises/' }]}
	schemas={schemas}
	title="Freelance IA & full-stack en France — Alexis Gallard"
	description="Applications web et desktop (Rust, Tauri), IA appliquée et automatisation (RAG, agents), infrastructure et production."
>
	<PageHeader
		eyebrow="Expertises"
		title="De votre besoin à un outil exploitable."
		lede="Créer une application, automatiser un processus ou préparer un déploiement : je relie le développement, l’IA et l’infrastructure pour vous accompagner sur l’ensemble du projet."
	/>

	<Section label="Domaines">
		<div class="grid gap-4">
			{domains.map((domain, i) => (
				<article id={`service-${i + 1}`}
					class="grid gap-6 rounded-[var(--radius-card)] border border-line bg-surface-hi p-6 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-10 md:p-8"
					data-reveal
					data-reveal-delay={i * 70}
				>
					<div>
						<p class="pill w-fit bg-accent text-accent-ink">{String(i + 1).padStart(2, '0')}</p>
						<h2 class="display mt-5 text-[clamp(1.6rem,3.5vw,2.4rem)] text-text">{domain.title}</h2>
						<p class="mt-5 max-w-[52ch] leading-relaxed text-muted">{domain.description}</p>
					</div>
					<div class="self-start">
						<h3 class="label">Technologies</h3>
						<ul class="mt-4 flex flex-wrap gap-2">
							{domain.stack.map((tech) => (
								<li class="chip max-w-full bg-bg text-muted">{tech}</li>
							))}
						</ul>
					</div>
				</article>
			))}
		</div>
	</Section>

	<Section label="En pratique" title="Des choix techniques mis en contexte.">
 <p class="max-w-[60ch] leading-relaxed text-muted">J’accompagne les entreprises partout en France, à distance depuis Poitiers. Ces projets illustrent ma démarche, avec leur périmètre et leur état d’avancement.</p>
 <ul class="mt-6 flex flex-col gap-4 text-accent-strong">
 <li><a class="underline" href="/projets/zero-secret/">Zero-Secret : accès temporaires et sécurité — prototype en cours</a></li>
 <li><a class="underline" href="/projets/agentic-os/">Agentic OS : orchestration et validation humaine — en cours</a></li>
 <li><a class="underline" href="/projets/la-minute-de-code/">La Minute de Code : site vitrine Astro réalisé</a></li>
 </ul>
 </Section>
 <Section label="Suite" title="Un besoin à transformer en outil ?" invert>
		<p class="max-w-[52ch] leading-relaxed text-slate-ink/80" data-reveal>
			Présentez-moi votre contexte, votre objectif et vos contraintes. Nous définirons ensemble une mission adaptée à votre entreprise, partout en France.
		</p>
		<a
			href="/contact"
			class="pill mt-8 inline-flex bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
			data-reveal
			data-reveal-delay="160"
		>
			Échangeons
		</a>
	</Section>
</Layout>
