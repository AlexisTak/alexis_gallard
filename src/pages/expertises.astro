---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

const domains = [
	{
		title: 'Application web ou desktop',
		description:
			"Applications et outils métiers de bout en bout, du cadrage à la production. Sur le web : React/Next.js, backend Node.js ou Laravel, base de données, déploiement. En logiciel installé : Rust, avec Tauri quand l'interface web est un atout, ou une interface native quand il faut de la performance et aucune dépendance au navigateur.",
		stack: ['TypeScript', 'React', 'Next.js', 'Node.js', 'NestJS', 'Laravel', 'Rust', 'Tauri', 'PostgreSQL'],
	},
	{
		title: 'Intelligence artificielle appliquée',
		description:
			"LLM intégrés à des outils réels : recherche augmentée (RAG) sur des corpus internes, agents qui automatisent des tâches répétitives, fine-tuning LoRA, arbitrage entre modèles propriétaires et open source selon les contraintes de coût et de confidentialité. Déploiement local inclus, avec l'optimisation que le matériel impose.",
		stack: ['LLM', 'RAG', 'LoRA', 'Mistral', 'Qwen', 'Ollama', 'Agents IA', 'Orchestration multi-modèles'],
	},
	{
		title: 'Infrastructure et sécurité',
		description:
			"Le versant qui décide si le reste tient : conteneurisation, CI/CD, déploiement et supervision en production. Côté sécurité, audit de code et d'architecture, pentest applicatif, contrôle d'accès et politiques RLS au niveau base plutôt qu'au niveau applicatif.",
		stack: ['Docker', 'Kubernetes', 'CI/CD', 'Terraform', 'Linux', 'Prometheus', 'Pentest applicatif', 'RLS'],
	},
];
---

<Layout
	title="Expertises — Alexis Gallard"
	description="Applications web et desktop (Rust, Tauri), IA appliquée (LLM, RAG, agents), infrastructure et sécurité. Domaines d'intervention et technologies."
>
	<PageHeader
		eyebrow="Expertises"
		title="Trois domaines, une même chaîne."
		lede="De l'architecture à l'exploitation. Ces trois domaines se recoupent en permanence : une intégration IA qui ne se déploie pas ne sert à rien, et une application sans contrôle d'accès sérieux non plus."
	/>

	{domains.map((domain, i) => (
		<Section label={String(i + 1).padStart(2, '0')}>
			<div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-16" data-reveal>
				<div>
					<h2 class="display text-[clamp(1.9rem,5vw,3.2rem)] text-text">{domain.title}</h2>
					<p class="mt-6 max-w-[52ch] leading-relaxed text-text/70">{domain.description}</p>
				</div>
				<div class="self-start border-l border-line pl-6">
					<h3 class="label">Technologies</h3>
					<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 md:flex-col md:gap-2">
						{domain.stack.map((tech) => (
							<li class="text-sm text-text/80">{tech}</li>
						))}
					</ul>
				</div>
			</div>
		</Section>
	))}

	<Section label="Suite">
		<h2 class="display max-w-[18ch] text-[clamp(1.9rem,5vw,3.4rem)]" data-reveal>
			Un poste où ça compte ?
		</h2>
		<p class="mt-8 max-w-[52ch] leading-relaxed text-text/70" data-reveal data-reveal-delay="80">
			Je suis ouvert aux opportunités, en Nouvelle-Aquitaine ou à distance. Dites-moi ce que
			l'équipe construit.
		</p>
		<a
			href="/contact"
			class="label mt-12 inline-block border border-accent bg-accent px-5 py-3 !text-accent-ink transition-colors hover:bg-transparent hover:!text-accent"
			data-reveal
			data-reveal-delay="160"
		>
			Échangeons
		</a>
	</Section>
</Layout>
