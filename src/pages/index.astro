---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const projects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const faq = [
	{
		question: 'Quels postes recherche Alexis Gallard ?',
		answer:
			"Des postes de développeur Fullstack Senior, d'AI Engineer ou d'architecte logiciel, en CDI. Les contextes qui l'intéressent sont ceux où une application doit réellement tenir en production : trafic réel, données sensibles, contraintes d'exploitation.",
	},
	{
		question: 'Où est-il basé et travaille-t-il à distance ?',
		answer:
			"Il est basé à Poitiers, en Nouvelle-Aquitaine. Il travaille sur place dans la région, et à distance partout ailleurs — il a mené des projets entiers en distanciel, du cadrage à la mise en production.",
	},
	{
		question: 'Quelle est son expérience en intelligence artificielle ?',
		answer:
			"Depuis 2022, il intègre des LLM dans des applications réelles : pipelines RAG sur des corpus internes, agents outillés, fine-tuning LoRA, et déploiement de modèles open source auto-hébergés quand les données ne doivent pas sortir de l'entreprise. Anti-Pépins, sa plateforme de détection d'arnaques, combine un moteur de règles et un LLM.",
	},
	{
		question: 'Quelles technologies maîtrise-t-il ?',
		answer:
			"Côté web, TypeScript avec React, Next.js et Vue.js, et des backends Node.js, NestJS ou Laravel. Côté logiciel installé, Rust avec Tauri ou une interface native. Côté infrastructure, Docker, Kubernetes, Terraform et des chaînes CI/CD complètes. Bases de données PostgreSQL, MySQL, MongoDB et Redis.",
	},
	{
		question: "Combien d'années d'expérience a-t-il ?",
		answer:
			"Douze ans, depuis 2014. Neuf ans comme développeur Fullstack chez Emmaüs Ruffec, et depuis 2022 en indépendant sur des missions d'architecture, de développement et d'intégration d'IA.",
	},
];

const schemas = [
	{
		'@type': 'FAQPage',
		'@id': `${SITE.url}/#faq`,
		mainEntity: faq.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	},
];

// Un vrai ordre : chaque étape conditionne la suivante. La numérotation dit quelque chose.
const process = [
	{
		title: 'Cadrage',
		text: "On clarifie le besoin réel, les contraintes techniques et budgétaires, et ce qui servira à mesurer le succès.",
	},
	{
		title: 'Architecture',
		text: 'Choix technique justifié plutôt que par défaut : la bonne stack pour le problème, pas la plus impressionnante sur le papier.',
	},
	{
		title: 'Développement',
		text: "Livraisons itératives, tests unitaires et d'intégration écrits avec le code, revues régulières. On voit le projet avancer, pas seulement le résultat final.",
	},
	{
		title: 'Intégration continue',
		text: "Chaque commit passe par la CI : tests, analyse statique, build. Une branche qui casse la suite ne part pas plus loin, et le déploiement cesse d'être un moment risqué.",
	},
	{
		title: 'Pré-production',
		text: "Un environnement identique à la production, aux données près : recette fonctionnelle, tests de bout en bout, vérification des migrations et des montées de charge avant que quiconque en dépende.",
	},
	{
		title: 'Production',
		text: 'Déploiement, supervision, alertes sur ce qui compte, et transfert de compétences quand une équipe reprend la main ensuite.',
	},
];
---

<Layout
	schemas={schemas}
	title="Alexis Gallard — Développeur Fullstack Senior & AI Engineer"
	description="Développeur Fullstack Senior et AI Engineer. Applications web, logiciels desktop en Rust et IA appliquée (LLM, RAG, agents), de l'architecture à la production. Poitiers, Nouvelle-Aquitaine."
>
	<Hero
		statement="Je construis des applications IA qui tiennent en production."
		support="Développeur Fullstack Senior et AI Engineer, 12 ans d'expérience. Applications web, logiciels desktop en Rust, intégration IA — LLM, RAG, agents — de l'architecture jusqu'à l'exploitation, infrastructure et déploiement inclus."
	/>

	<Section label="Travail" title="Trois projets qui tournent." id="travail">
		<div class="grid gap-4 md:grid-cols-2">
			{projects.map((project, i) => (
				<ProjectRow
					slug={project.id}
					title={project.data.title}
					subtitle={project.data.subtitle}
					summary={project.data.summary}
					stack={project.data.stack}
					delay={i * 80}
				/>
			))}
		</div>

		<a
			href="/projets"
			class="pill mt-6 inline-flex border border-line px-5 py-3 text-text transition-colors hover:border-accent-strong hover:text-accent-strong"
			data-reveal
		>
			Toutes les études de cas ↗
		</a>
	</Section>

	<Section label="Méthode" title="Six étapes, dans cet ordre." id="methode">
		<ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
			{process.map((step, i) => (
				<li
					class="flex flex-col gap-3 rounded-[var(--radius-card)] border border-line bg-surface-hi p-6"
					data-reveal
					data-reveal-delay={i * 60}
				>
					<span class="pill w-fit bg-accent text-accent-ink">
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3 class="text-lg font-semibold text-text">{step.title}</h3>
					<p class="leading-relaxed text-muted">{step.text}</p>
				</li>
			))}
		</ol>
	</Section>

	<Section label="Questions" title="Ce qu'on me demande le plus." id="questions">
		<dl class="flex flex-col gap-4">
			{faq.map((item, i) => (
				<div
					class="grid gap-3 rounded-[var(--radius-card)] border border-line bg-surface-hi p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-10"
					data-reveal
					data-reveal-delay={i * 50}
				>
					<dt class="max-w-[28ch] text-lg font-semibold text-text">{item.question}</dt>
					<dd class="max-w-[58ch] leading-relaxed text-muted">{item.answer}</dd>
				</div>
			))}
		</dl>
	</Section>

	<Section label="Suite" title="Une équipe à renforcer ?" id="suite" invert>
		<p class="max-w-[52ch] leading-relaxed text-slate-ink/80" data-reveal>
			Ouvert aux opportunités, en Nouvelle-Aquitaine ou à distance. Réponse sous 48 heures.
		</p>
		<a
			href="/contact"
			class="pill mt-8 inline-flex bg-accent px-5 py-3 text-accent-ink transition-opacity hover:opacity-90"
			data-reveal
			data-reveal-delay="80"
		>
			Échangeons
		</a>
	</Section>
</Layout>
