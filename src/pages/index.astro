---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import WorkReel from '../components/WorkReel.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

// Un vrai ordre : chaque étape conditionne la suivante. La numérotation dit quelque chose.
const process = [
	{
		title: 'Cadrage',
		text: "On clarifie le besoin réel, les contraintes techniques et budgétaires, et ce qui servira à mesurer le succès.",
	},
	{
		title: 'Architecture',
		text: 'Choix technique justifié plutôt que par défaut : la bonne stack pour le problème, pas la plus impressionnante sur le papier.',
	},
	{
		title: 'Développement',
		text: "Livraisons itératives, tests unitaires et d'intégration écrits avec le code, revues régulières. On voit le projet avancer, pas seulement le résultat final.",
	},
	{
		title: 'Intégration continue',
		text: "Chaque commit passe par la CI : tests, analyse statique, build. Une branche qui casse la suite ne part pas plus loin, et le déploiement cesse d'être un moment risqué.",
	},
	{
		title: 'Pré-production',
		text: "Un environnement identique à la production, aux données près : recette fonctionnelle, tests de bout en bout, vérification des migrations et des montées de charge avant que quiconque en dépende.",
	},
	{
		title: 'Production',
		text: 'Déploiement, supervision, alertes sur ce qui compte, et transfert de compétences quand une équipe reprend la main ensuite.',
	},
];
---

<Layout
	title="Alexis Gallard — Développeur Fullstack Senior & AI Engineer"
	description="Développeur Fullstack Senior et AI Engineer. Applications web, logiciels desktop en Rust et IA appliquée (LLM, RAG, agents), de l'architecture à la production. Poitiers, Nouvelle-Aquitaine."
>
	<Hero
		eyebrow="Ouvert aux opportunités · Poitiers · Nouvelle-Aquitaine"
		statement="Je construis des applications IA qui tiennent en production."
		support="Développeur Fullstack Senior et AI Engineer, 12 ans d'expérience. Applications web, logiciels desktop en Rust, intégration IA — LLM, RAG, agents — de l'architecture jusqu'à l'exploitation, sécurité et infrastructure incluses."
	/>

	<WorkReel projects={projects} />


	<Section label="Méthode" id="methode">
		<h2 class="display max-w-[16ch] text-[clamp(1.9rem,5vw,3.4rem)]" data-reveal>
			Six étapes, dans cet ordre.
		</h2>

		<ol class="mt-16 flex flex-col">
			{process.map((step, i) => (
				<li
					class="grid gap-4 border-t border-line py-8 md:grid-cols-[4rem_12rem_minmax(0,1fr)] md:gap-8"
					data-reveal
					data-reveal-delay={i * 80}
				>
					<span class="label !text-accent">{String(i + 1).padStart(2, '0')}</span>
					<h3 class="text-lg font-medium text-text">{step.title}</h3>
					<p class="max-w-[52ch] leading-relaxed text-text/70">{step.text}</p>
				</li>
			))}
		</ol>
	</Section>

	<Section label="Suite" id="suite">
		<h2 class="display max-w-[14ch] text-[clamp(2rem,6vw,4rem)]" data-reveal>
			Une équipe à renforcer ?
		</h2>
		<p class="mt-8 max-w-[52ch] leading-relaxed text-text/70" data-reveal data-reveal-delay="80">
			Ouvert aux opportunités, en Nouvelle-Aquitaine ou à distance.
			Réponse sous 48 heures.
		</p>
		<a
			href="/contact"
			class="label mt-12 inline-block border border-accent bg-accent px-5 py-3 !text-accent-ink transition-colors hover:bg-transparent hover:!text-accent"
			data-reveal
			data-reveal-delay="160"
		>
			Échangeons
		</a>
	</Section>
</Layout>
