---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

const offers = [
	{
		title: "Application Fullstack",
		description:
			"Conception et développement d'applications web ou d'outils métiers sur mesure, du cadrage à la production : frontend React/Next.js, backend Node.js ou Laravel, base de données, déploiement.",
		price: 'À partir de 4 000 €',
		delay: '3 à 8 semaines',
	},
	{
		title: 'Intégration IA',
		description:
			"LLM dans vos outils existants : recherche augmentée (RAG) sur vos documents internes, agents qui automatisent des tâches répétitives, arbitrage entre modèles propriétaires et open source selon vos contraintes de coût et de confidentialité.",
		price: 'Sur devis · TJM 550 €',
		delay: 'Cadrage offert · 45 min',
	},
	{
		title: 'Audit technique',
		description:
			"Audit de code, d'architecture ou de sécurité — pentest applicatif, contrôle d'accès, exposition d'API — avec un rapport priorisé et des recommandations que votre équipe peut appliquer directement.",
		price: 'À partir de 900 €',
		delay: '3 à 5 jours',
	},
];
---

<Layout
	title="Offres — Alexis Gallard"
	description="Développement Fullstack, intégration IA (LLM, RAG, agents) et audit technique. Offres, tarifs et délais."
>
	<PageHeader
		eyebrow="Offres"
		title="Trois façons de travailler ensemble."
		lede="Les fourchettes donnent un ordre de grandeur. Chaque devis est ajusté au périmètre réel après un premier échange."
	/>

	{offers.map((offer, i) => (
		<Section label={String(i + 1).padStart(2, '0')}>
			<div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-16" data-reveal>
				<div>
					<h2 class="display text-[clamp(1.9rem,5vw,3.2rem)] text-text">{offer.title}</h2>
					<p class="mt-6 max-w-[52ch] leading-relaxed text-text/70">{offer.description}</p>
				</div>
				<dl class="flex flex-col gap-6 self-start border-l border-line pl-6">
					<div>
						<dt class="label">Budget</dt>
						<dd class="mt-2 text-lg text-accent">{offer.price}</dd>
					</div>
					<div>
						<dt class="label">Délai type</dt>
						<dd class="mt-2 text-text">{offer.delay}</dd>
					</div>
				</dl>
			</div>
		</Section>
	))}

	<Section label="Suite">
		<h2 class="display max-w-[18ch] text-[clamp(1.9rem,5vw,3.4rem)]" data-reveal>
			Pas sûr de l'offre qui correspond ?
		</h2>
		<p class="mt-8 max-w-[52ch] leading-relaxed text-text/70" data-reveal data-reveal-delay="80">
			Décrivez le besoin, je vous oriente — y compris vers quelqu'un d'autre si ce n'est pas mon terrain.
		</p>
		<a
			href="/contact"
			class="label mt-12 inline-block border border-accent bg-accent px-5 py-3 !text-accent-ink transition-colors hover:bg-transparent hover:!text-accent"
			data-reveal
			data-reveal-delay="160"
		>
			Décrire le besoin
		</a>
	</Section>
</Layout>
